# PostgreSQL（记忆数据落库，schema=memory_eval）
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DB_NAME

# 模型（DashScope Responses API，extract/daily/answer/judge 共用）
LLM_MODEL=qwen3.7-max
DASHSCOPE_RESPONSES_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# Embedding（Fast/Long 向量，维度 1024）
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# JEV（daily 的 Domain/相关块结构化判断，可选；留空 JEV_MODEL 则降级跳过）
JEV_MODEL=jev-latest
JEV_BASE_URL=https://www.dmxapi.cn
JEV_API_KEY=
