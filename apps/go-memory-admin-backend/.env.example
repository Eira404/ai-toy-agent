# 结构与默认值在 config.yaml，这里只放密钥与可选覆盖值（供 ${...} 插值）。

# PostgreSQL（复用 Go 记忆后端同一个库）
DATABASE_URL=postgresql://app:dev_password_change_me@127.0.0.1:5432/appdb
# 可选：PostgreSQL schema 名（默认 public）
DB_SCHEMA=

# HTTP（默认见 config.yaml）
HOST=127.0.0.1
PORT=3200

# 管理员能力与账号端点挂载前缀（默认 /admin）
ADMIN_MOUNT_PATH=/admin

# 首个 superadmin：首次启动会用它 bootstrap，之后可删除/改密。
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=

# LLM（Responses API，MemoryDaily 用）
DASHSCOPE_RESPONSES_BASE_URL=https://dashscope.aliyuncs.com/api/v1/responses
DASHSCOPE_API_KEY=sk-xxx

# Embedding（Daily 写 Long 向量用）
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/embeddings
EMBEDDING_DIMENSIONS=1024

# JEV（可选；不配置则 Daily 跳过 JEV，并删除 config.yaml 的 jev 段）
JEV_BASE_URL=
JEV_API_KEY=
