# 结构与模型/链的映射在 config.yaml；这里只放密钥与可选覆盖值（供 ${...} 插值）。

# PostgreSQL（关系 + pgvector，可复用同一库）
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/memory
# 可选：PostgreSQL schema 名（默认 public）
DB_SCHEMA=

# LLM（Responses API）
DASHSCOPE_RESPONSES_BASE_URL=https://dashscope.aliyuncs.com/api/v1/responses
DASHSCOPE_API_KEY=sk-xxx

# Embedding
EMBEDDING_DIMENSIONS=1024
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/embeddings

# JEV（MemoryDaily 用；不配置则 JEV 禁用，config.yaml 的 jev.adapters 留空）
JEV_BASE_URL=
JEV_API_KEY=
# JEV 模型已改由 config.yaml 的 jev.chains 条目指定（同一 typesafe adapter 可多模型降级）

# HTTP
HOST=127.0.0.1
PORT=3100

# 新建记忆空间时自动挂载的 daily 调度；DAILY_AT 不设则每个新建空间随机 02:00–02:59
# DAILY_AT=03:00
DAILY_TIME_ZONE=Asia/Shanghai
DAILY_MIN_PENDING_FAST=10
