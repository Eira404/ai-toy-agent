{
  "name": "toy-agent-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn 预处理、模型与工具闭环、阻塞与非阻塞后处理的 Agent 执行循环",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "example": "npm run build && node examples/basic.mjs"
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.12",
    "toy-agent": "0.1.0",
    "toy-lifecycle": "0.1.0",
    "toy-llm": "0.1.0",
    "toy-session": "0.1.0",
    "toy-session-data": "0.1.0",
    "toy-session-storage": "0.1.0",
    "toy-tools": "0.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
