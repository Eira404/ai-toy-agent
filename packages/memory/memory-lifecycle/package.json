{
  "name": "toy-memory-lifecycle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在线记忆编排：解析记忆空间、JEV 门控提取，并把提取结果注入系统提示",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.12",
    "toy-agent-loop": "0.1.0",
    "toy-session": "0.1.0",
    "toy-model-support": "0.1.0",
    "toy-memory-space": "0.1.0",
    "toy-memory-write": "0.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
