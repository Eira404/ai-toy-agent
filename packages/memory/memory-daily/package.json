{
  "name": "toy-memory-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily Dream：把 Fast 整理为 Long 的离线链路，含巩固价值计算、内容各阶段与原子提交",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "example": "npm run build && node examples/basic.mjs"
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.12",
    "toy-storage": "0.1.0",
    "toy-storage-relational": "0.1.0",
    "toy-memory-fast": "0.1.0",
    "toy-memory-long": "0.1.0",
    "toy-memory-feedback": "0.1.0",
    "toy-llm": "0.1.0",
    "toy-jev": "0.1.0",
    "toy-embedding": "0.1.0",
    "toy-parallel-executor": "0.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
