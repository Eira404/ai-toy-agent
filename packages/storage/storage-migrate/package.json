{
  "name": "toy-storage-migrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "声明式 PostgreSQL 迁移工具：对比逻辑 Schema 与物理库，生成并应用 DDL",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "toy-storage-relational": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.15.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
